# Sao chép thành .env và điền giá trị thật. KHÔNG commit .env (NFR-30).
DATABASE_URL=postgresql+psycopg://giasu:giasu@localhost:5432/giasu
CORS_ORIGINS=["http://localhost:3000"]

# Khóa nhà cung cấp LLM — chỉ tồn tại ở backend, không lộ ra client
LLM_API_KEY_PRIMARY=
LLM_API_KEY_SECONDARY=

# Xác thực — ĐỔI jwt_secret ở production (tối thiểu 32 byte ngẫu nhiên)
JWT_SECRET=dev-secret-doi-ngay-o-production-toi-thieu-32-byte
JWT_EXPIRE_MINUTES=480
