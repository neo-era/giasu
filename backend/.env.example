# Sao chép thành .env và điền giá trị thật. KHÔNG commit .env (NFR-30).
DATABASE_URL=postgresql+psycopg://giasu:giasu@localhost:5432/giasu
CORS_ORIGINS=["http://localhost:3000"]

# Khóa nhà cung cấp LLM — chỉ tồn tại ở backend, không lộ ra client (NFR-30)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ánh xạ bậc model (JSON). Bỏ trống = dùng mock (dev). Ví dụ production:
# LLM_TIERS={"re":"anthropic:claude-haiku-4-5","can_bang":"anthropic:claude-sonnet-4-6","reasoning":"anthropic:claude-opus-4-8","vision":"anthropic:claude-haiku-4-5"}
# LLM_FALLBACK_TIER=re

# Xác thực — ĐỔI jwt_secret ở production (tối thiểu 32 byte ngẫu nhiên)
JWT_SECRET=dev-secret-doi-ngay-o-production-toi-thieu-32-byte
JWT_EXPIRE_MINUTES=480
